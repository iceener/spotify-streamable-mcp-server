{
  "name": "mcp-spotify",
  "private": true,
  "description": "Spotify MCP server for Bun and Cloudflare Workers, with an OAuth proxy in front of Spotify",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "bun --watch src/bun.ts",
    "dev:worker": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "start": "bun src/bun.ts",
    "deploy": "wrangler deploy --config wrangler.production.jsonc",
    "check": "bun run typecheck && bun run lint && bun test && bun run types:worker:check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:smoke": "bun scripts/smoke-bun.ts && node --disable-warning=ExperimentalWarning scripts/smoke-worker.ts",
    "types:worker": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false WRANGLER_HIDE_BANNER=true wrangler types --strict-vars=false",
    "types:worker:check": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false WRANGLER_HIDE_BANNER=true wrangler types --strict-vars=false --check",
    "inspector": "npx -y @modelcontextprotocol/inspector@2.8.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "@spotify/web-api-ts-sdk": "1.2.0",
    "hono": "4.13.9",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/client": "2.3.0",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "wrangler": "4.142.0"
  }
}
